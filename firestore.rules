rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // REUSABLE AUTHENTICATION & OWNERSHIP HELPERS
    // =========================================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    // Resolves child document to verify parent ownership
    function isParentOfChild(childId) {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/children/$(childId)).data.parentUid == request.auth.uid
      );
    }

    // =========================================================================
    // 0. USER PROFILES & PARENT SECURITY (PIN)
    // =========================================================================
    match /users/{uid} {
      allow read: if isAuthenticated() && (isAdmin() || request.auth.uid == uid);
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow update: if isAuthenticated() && (isAdmin() || request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    match /parentSecurity/{uid} {
      allow read, write: if false; // Server-only via Firebase Admin SDK (Zero client exposure)
    }

    // =========================================================================
    // 1. CHILDREN PROFILES (Strict Immutable parentUid & Split Update/Delete)
    // =========================================================================
    match /children/{childId} {
      allow read: if isAuthenticated() && (
        isAdmin() || (resource != null && resource.data.parentUid == request.auth.uid)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.parentUid == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        isAdmin() || (
          resource.data.parentUid == request.auth.uid &&
          request.resource.data.parentUid == resource.data.parentUid
        )
      );
      allow delete: if isAuthenticated() && (
        isAdmin() || resource.data.parentUid == request.auth.uid
      );
    }

    // =========================================================================
    // 2. SERVER-TRUSTED REWARD LEDGER (Write blocked; Read gated to owning parent)
    // =========================================================================
    match /rewardTransactions/{txId} {
      allow write: if false; // Server-only via Firebase Admin SDK
      allow read: if isAuthenticated() && (
        isAdmin() || (resource != null && isParentOfChild(resource.data.childId))
      );
    }

    match /rewardBalances/{childId} {
      allow write: if false; // Server-only via Firebase Admin SDK
      allow read: if isAuthenticated() && (
        isAdmin() || isParentOfChild(childId)
      );
    }

    // =========================================================================
    // 3. CURRICULUM, UNITS, LESSONS (Read-only for authenticated, write gated to admin)
    // =========================================================================
    match /curricula/{curriculumId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /units/{unitId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // =========================================================================
    // 4. STUDENT PROGRESS (Immutable childId on update)
    // =========================================================================
    match /studentProgress/{progressId} {
      allow read: if isAuthenticated() && (
        isAdmin() || (resource != null && isParentOfChild(resource.data.childId))
      );
      allow create: if isAuthenticated() && (
        isAdmin() || isParentOfChild(request.resource.data.childId)
      );
      allow update: if isAuthenticated() && (
        isAdmin() || (
          isParentOfChild(resource.data.childId) &&
          isParentOfChild(request.resource.data.childId) &&
          request.resource.data.childId == resource.data.childId
        )
      );
      allow delete: if isAuthenticated() && (
        isAdmin() || (resource != null && isParentOfChild(resource.data.childId))
      );
    }

    // =========================================================================
    // 5. KNOWLEDGE MASTERY (Immutable studentId on update)
    // =========================================================================
    match /knowledgeMastery/{masteryId} {
      allow read: if isAuthenticated() && (
        isAdmin() || (resource != null && isParentOfChild(resource.data.studentId))
      );
      allow create: if isAuthenticated() && (
        isAdmin() || isParentOfChild(request.resource.data.studentId)
      );
      allow update: if isAuthenticated() && (
        isAdmin() || (
          isParentOfChild(resource.data.studentId) &&
          isParentOfChild(request.resource.data.studentId) &&
          request.resource.data.studentId == resource.data.studentId
        )
      );
      allow delete: if isAuthenticated() && (
        isAdmin() || (resource != null && isParentOfChild(resource.data.studentId))
      );
    }

    // =========================================================================
    // 6. PETS COMPANION (Immutable childId on update & childId-only read auth)
    // =========================================================================
    match /pets/{petId} {
      allow read: if isAuthenticated() && (
        isAdmin() || (resource != null && isParentOfChild(resource.data.childId))
      );
      allow create: if isAuthenticated() && (
        isAdmin() || isParentOfChild(request.resource.data.childId)
      );
      allow update: if isAuthenticated() && (
        isAdmin() || (
          isParentOfChild(resource.data.childId) &&
          isParentOfChild(request.resource.data.childId) &&
          request.resource.data.childId == resource.data.childId
        )
      );
      allow delete: if isAuthenticated() && (
        isAdmin() || (resource != null && isParentOfChild(resource.data.childId))
      );
    }
  }
}
