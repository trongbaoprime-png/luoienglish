rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isParentOwner(parentUid) {
      return isAuthenticated() && request.auth.uid == parentUid;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    // 1. Children Profiles: Scoped strictly to parent owner
    match /children/{childId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.parentUid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.parentUid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.parentUid == request.auth.uid && request.resource.data.parentUid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.parentUid == request.auth.uid;
    }

    // 2. Server-Trusted Reward Ledger: Untrusted client writes are strictly forbidden
    match /rewardTransactions/{txId} {
      allow read: if isAuthenticated();
      allow write: if false; // Server-only through Firebase Admin SDK
    }

    match /rewardBalances/{childId} {
      allow read: if isAuthenticated();
      allow write: if false; // Server-only through Firebase Admin SDK
    }

    // 3. Curriculum, Units, Lessons: Read-only for authenticated users, write gated to admin
    match /curricula/{curriculumId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /units/{unitId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 4. Student Progress & Memory Mastery
    match /studentProgress/{progressId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /knowledgeMastery/{masteryId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 5. Pets Companion
    match /pets/{petId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
