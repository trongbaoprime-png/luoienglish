# Meta Marketing API Credentials (Multi-Account Setup)
# 1. System User / User Access Token (Permissions: ads_read, read_insights)
META_API_TOKEN=EAAG...

# 2. Account Selection Option A: Comma-separated list of Ad Account IDs (with or without 'act_')
META_AD_ACCOUNT_IDS=act_101,act_102,act_103,act_104,act_105,act_106,act_107,act_108,act_109,act_110,act_111

# 3. Account Selection Option B: Meta Business Manager ID (Auto-discovers all 11 accounts)
META_BUSINESS_ID=
