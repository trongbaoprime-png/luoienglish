# ==============================================================================
# LƯỜI ENGLISH — Environment Variables Example
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security Secrets (Server-only, minimum 32 random characters)
PARENT_SESSION_SECRET=your-minimum-32-char-random-parent-session-secret

# Firebase Public Configuration (Client)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=luoi-english.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=luoi-english
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=luoi-english.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Firebase Admin Configuration (Server-only)
FIREBASE_ADMIN_PROJECT_ID=luoi-english
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@luoi-english.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC3...-----END PRIVATE KEY-----\n"

# AI Gateway Keys (Server-only, never expose to client)
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_DEFAULT_PROVIDER=mock # or 'gemini' | 'openai' | 'anthropic'
